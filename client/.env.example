# Copy to .env.public.local for the public app, or .env.<mode>.local for a role app.
# Modes: public, admin, store, courier. Customer login is in the public app.
# Role apps need their role suffix, e.g. http://127.0.0.1:3200/api/admin.
# Only public browser configuration belongs in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:3200/api
VITE_PUBLIC_APP_URL=http://127.0.0.1:5173
VITE_ADMIN_APP_URL=http://127.0.0.1:5174
VITE_SHOP_APP_URL=http://127.0.0.1:5175
VITE_COURIER_APP_URL=http://127.0.0.1:5176
